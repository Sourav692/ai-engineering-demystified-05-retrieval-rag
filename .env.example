# Copy to .env and fill in only what the notebooks you run need. Names only; never commit values.

# --- Models -------------------------------------------------------------------
# OpenAI: embeddings and chat models in most notebooks, and helpers.get_openai_llm()
OPENAI_API_KEY=
# Chat model used by the canonical lessons and the query-transformation notebooks, via helpers.get_experientiallabs_llm()
EXPERIENTIALLABS_API_KEY=
# Groq chat models (several splitter/vector-store/retriever notebooks and helpers.get_groq_llm())
GROQ_API_KEY=
# Databricks: helpers.get_llm()/get_embeddings() default provider, and the Databricks Vector Search notebooks
DATABRICKS_HOST=
DATABRICKS_TOKEN=
# Cohere: the raw cohere.Client in contextual chunk headers (06/07) and relevant segment extraction (09/07)
CO_API_KEY=
# Cohere: read implicitly by langchain-cohere's CohereEmbeddings (11/02 captioning notebook)
COHERE_API_KEY=
# Google Gemini vision model for image captioning (11/02)
GOOGLE_API_KEY=
# Hugging Face Hub token for the local HF + FAISS RAG notebook (10/06)
HUGGINGFACEHUB_API_TOKEN=

# --- Vector stores ------------------------------------------------------------
# DataStax Astra DB (05/06)
ASTRA_DB_API_ENDPOINT=
ASTRA_DB_APPLICATION_TOKEN=
# Pinecone (05/07 has you paste the key into its api_key variable; langchain-pinecone also reads this name)
PINECONE_API_KEY=

# --- Tracing (optional) -------------------------------------------------------
# LangSmith: the query-transformation notebooks set LANGSMITH_PROJECT/LANGSMITH_TRACING themselves
LANGSMITH_API_KEY=
LANGSMITH_TRACING=
LANGSMITH_PROJECT=
